---
const { title = "Culture Explorer — A field guide to beauty, memory, and civilization", description = "Learn to see what civilizations made, then see your own place with the same standard." } = Astro.props
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/favicon.ico" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;1,8..60,400&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/site.css" />
  <style>
    .btn.btn-green, a.btn.btn-green {
      color: #fbf6ec !important;
      background: #3b5538 !important;
      border-color: #3b5538 !important;
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
     <a class="brand" href="/" style="display:flex;align-items:center;gap:0.65rem;text-decoration:none;">
  <img
    src="/logo.png"
    alt="Culture Explorer"
    width="40"
    height="40"
    style="width:40px;height:40px;border-radius:50%;object-fit:cover;flex-shrink:0;"
  />
  <span class="brand-name">Culture Explorer</span>
</a>
    <nav class="nav">
  <a href="/see">How to See</a>
  <a href="/atlas">Atlas</a>
  <a href="/journeys">Journeys</a>
  <a href="/street">Your Street</a>
  <a href="/inheritance">Inheritance</a>
  <a href="/essays">Essays</a>
  <a href="/about">About</a>
  <a class="btn btn-green" href="https://newsletter.thecultureexplorer.com" target="_blank" rel="noopener">Subscribe</a>
</nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <h3>Culture Explorer</h3>
          <p>A movement for beauty, tradition, and civilizational memory.</p>
        </div>
        <div>
          <h3>Explore</h3>
          <div class="foot-links">
            <a href="/see">How to See</a>
            <a href="/atlas">Atlas</a>
            <a href="/journeys">Journeys</a>
            <a href="/#street">Your Street</a>
            <a href="/#inheritance">Inheritance</a>
          </div>
        </div>
        <div>
          <h3>Follow</h3>
          <div class="foot-links">
            <a href="https://newsletter.thecultureexplorer.com" target="_blank" rel="noopener">Newsletter</a>
            <a href="https://x.com/CultureExploreX" target="_blank" rel="noopener">X</a>
            <a href="/#about">About</a>
          </div>
        </div>
      </div>
      <div class="legal">
        <span>Read weekly. Travel with intention. Honor what is beautiful.</span>
        <span>© Culture Explorer</span>
      </div>
    </div>
  </footer>
</body>
</html>
