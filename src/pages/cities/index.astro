---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { fetchCities } from "../../lib/sanity"

const cities = await fetchCities()
---
<BaseLayout title="Cities — Culture Explorer" description="Field guides: locations, museums, and masterpieces.">
  <section class="page-hero">
    <div class="wrap">
      <div class="kicker">Catalog</div>
      <h1>Cities</h1>
      <p class="lede">Enter a city. Walk its locations. Stay with the works that still ask something of you.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="grid-3">
        {cities.map((c) => (
          <a class="card" href={`/cities/${c.id}`}>
            <div class="media wide">
              {c.heroImage
                ? <img src={c.heroImage} alt={c.name} />
                : <img src={`/images/${c.id}.jpg`} alt={c.name} />}
            </div>
            <div class="body">
              <div class="meta">{c.country}</div>
              <h3>{c.name}</h3>
              <p>{c.tagline}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
