---
import BaseLayout from "../layouts/BaseLayout.astro"
---
<BaseLayout
  title="Look: Weathered Marble — Culture Explorer"
  description="A looking ritual for weathered marble sculpture. Look before you read; earn the work into your inheritance."
>
  <div class="look-layout">
    <div class="look-image">
     src="/images/statue.jpg"
    </div>
    <aside class="look-panel">
      <div class="kicker">Sculpture · looking ritual</div>
      <h2>Do not name him yet.</h2>
      <p class="muted">Two minutes of looking. Write before you read.</p>
      <div class="timer" id="timer">02:00</div>
      <p style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn btn-solid" type="button" id="startBtn">Start looking</button>
        <button class="btn" type="button" id="unlockBtn">I have looked</button>
      </p>
      <ul class="prompt-list">
        <li>Where does the light hit, and where does it fail?</li>
        <li>What has time done to the stone?</li>
        <li>What is the mouth doing?</li>
        <li>Would a city still pay for a face like this?</li>
      </ul>
      <label class="kicker" for="notes">Your notes</label>
      <textarea id="notes" class="notes" placeholder="Describe only what you see."></textarea>
      <div class="locked-note" id="lockedNote">
        The essay stays closed until you look. Attention is the price of admission.
      </div>
      <div class="unlock" id="unlockPanel">
        <h3>What it asked. What it formed.</h3>
        <p>
          This is the kind of face antiquity thought a city could live with: not charming, not branded, not young. The beard is a system of shadows. The eyes do not perform for you. Damage is left visible. A civilization that could carve this believed the human form was a public argument — about dignity, about gods who were not cute, about the body as a measure of order.
        </p>
        <p>
          Compare this with the smooth, interchangeable figures we now place in plazas. One asks you to stand still. The other asks you to take a photograph and leave.
        </p>
        <p>
          Transfer: find a public statue near you. Ask whether it would still be worth looking at if the plaque were removed.
        </p>
        <p>
          <button
            class="btn btn-green"
            type="button"
            id="earnBtn"
            data-earn="statue-marble"
            data-title="Weathered marble, still speaking"
            data-kind="Sculpture"
            data-href="/work-statue"
data-image="/images/statue.jpg"
          >
            Add to Inheritance
          </button>
        </p>
        <p><a href="/work-venus">Next: Botticelli →</a></p>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .look-layout {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    min-height: calc(100vh - 72px);
  }
  .look-image {
    position: relative;
    background: #111;
    min-height: 70vh;
  }
  .look-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }
  .look-panel {
    padding: 2.3rem 2rem 3rem;
    background: var(--paper, #f4ead8);
    border-left: 1px solid var(--rule, #d0c0a6);
  }
  .timer {
    font-family: var(--serif, "Cormorant Garamond", Georgia, serif);
    font-size: 3.4rem;
    letter-spacing: 0.04em;
    line-height: 1;
    margin: 0.5rem 0 1rem;
  }
  textarea.notes {
    width: 100%;
    min-height: 140px;
    background: var(--cream, #fbf6ec);
    border: 1px solid var(--rule, #d0c0a6);
    padding: 0.9rem;
    resize: vertical;
    margin: 0.5rem 0 1rem;
  }
  .prompt-list {
    padding-left: 1.1rem;
    color: var(--ink-2, #3b3228);
  }
  .prompt-list li {
    margin-bottom: 0.4rem;
  }
  .unlock {
    display: none;
    margin-top: 1.25rem;
  }
  .unlock.is-open {
    display: block;
  }
  .locked-note {
    border: 1px dashed var(--rule, #d0c0a6);
    padding: 1rem;
    color: var(--ink-3, #6e6254);
  }
  .locked-note.is-hidden {
    display: none;
  }
  @media (max-width: 900px) {
    .look-layout {
      grid-template-columns: 1fr;
    }
    .look-image {
      min-height: 50vh;
      position: relative;
    }
    .look-image img {
      position: relative;
      height: 50vh;
    }
  }
</style>

<script>
  const secondsTotal = 120
  let remaining = secondsTotal
  let timerId = null
  const timerEl = document.getElementById("timer")
  const startBtn = document.getElementById("startBtn")
  const unlockBtn = document.getElementById("unlockBtn")
  const unlockPanel = document.getElementById("unlockPanel")
  const lockedNote = document.getElementById("lockedNote")
  const earnBtn = document.getElementById("earnBtn")

  function format(s) {
    const m = Math.floor(s / 60)
    const r = s % 60
    return String(m).padStart(2, "0") + ":" + String(r).padStart(2, "0")
  }

  function tick() {
    remaining -= 1
    if (timerEl) timerEl.textContent = format(Math.max(remaining, 0))
    if (remaining <= 0) {
      clearInterval(timerId)
      timerId = null
      openUnlock()
    }
  }

  function openUnlock() {
    unlockPanel?.classList.add("is-open")
    lockedNote?.classList.add("is-hidden")
  }

  startBtn?.addEventListener("click", () => {
    if (timerId) return
    remaining = secondsTotal
    if (timerEl) timerEl.textContent = format(remaining)
    timerId = setInterval(tick, 1000)
  })

  unlockBtn?.addEventListener("click", () => {
    if (timerId) {
      clearInterval(timerId)
      timerId = null
    }
    openUnlock()
  })

  earnBtn?.addEventListener("click", () => {
    try {
      const key = "ce-inheritance"
      const raw = localStorage.getItem(key)
      const list = raw ? JSON.parse(raw) : []
      const item = {
        id: earnBtn.getAttribute("data-earn"),
        title: earnBtn.getAttribute("data-title"),
        kind: earnBtn.getAttribute("data-kind"),
        href: earnBtn.getAttribute("data-href"),
        at: new Date().toISOString(),
image: earnBtn.getAttribute("data-image"),
      }
      if (!list.some((x) => x.id === item.id)) list.push(item)
      localStorage.setItem(key, JSON.stringify(list))
      earnBtn.textContent = "Added to Inheritance"
    } catch (e) {}
  })
</script>