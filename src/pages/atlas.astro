---
import BaseLayout from "../layouts/BaseLayout.astro"
import { fetchMasterpieces } from "../lib/sanity"

const works = await fetchMasterpieces()
const hero = "/images/library.jpg"
---
<BaseLayout title="Atlas — Culture Explorer" description="Masterpieces that preserve civilizational memory.">
  <section style="position:relative;min-height:70vh;display:grid;align-items:end;overflow:hidden;">
    <img src={hero} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,14,10,0.25),rgba(20,14,10,0.78));"></div>
    <div class="wrap" style="position:relative;z-index:2;padding:4rem 0 3rem;color:#f7f1e6;">
      <div class="kicker" style="color:#e6c48a;">A growing atlas of rooms, images, and public form</div>
      <h1 style="color:#fff;max-width:16ch;margin-top:0.6rem;">Masterpieces that preserve civilizational memory.</h1>
      <p class="lede" style="color:rgba(247,241,230,0.9);max-width:40ch;">Each entry is a doorway into attention — not a thumbnail in a feed.</p>
    </div>
  </section>

  <section style="padding-top:1.5rem;">
    <div class="wrap">
      <div style="display:flex;flex-wrap:wrap;gap:0.6rem;margin-bottom:2rem;">
        <span class="btn" style="background:#16110c;color:#fbf6ec;border-color:#16110c;">All</span>
        <span class="btn">Paintings</span>
        <span class="btn">Sculptures</span>
        <span class="btn">Architecture</span>
      </div>

      <div class="grid-3">
        {works.map((w) => (
          <a class="card" href={`/works/${w.id}`}>
            <div class="media">
              {w.image
  ? <img
      src={`${w.image}?w=600&auto=format`}
      alt={w.title}
      width="600"
      height="400"
      loading="lazy"
      decoding="async"
    />
  : <img
      src="/images/statue.jpg"
      alt={w.title}
      width="600"
      height="400"
      loading="lazy"
      decoding="async"
    />}
            </div>
            <div class="body">
              <div class="meta">{w.kind}{w.cityName ? ` · ${w.cityName}` : ""}</div>
              <h3>{w.title}</h3>
              <p class="muted">{w.artist}</p>
              <p>{w.cardBlurb}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
